# enterprise-knowledge :: environment template  (cp .env.example .env)

# --- storage -----------------------------------------------------------------
POSTGRES_USER=ek
POSTGRES_PASSWORD=ek
POSTGRES_DB=enterprise_knowledge
POSTGRES_PORT=55433
EK_DATABASE_URL=postgresql://ek:ek@localhost:55433/enterprise_knowledge
EK_POOL_MIN_SIZE=1
EK_POOL_MAX_SIZE=8

# --- embeddings --------------------------------------------------------------
# deterministic | openai
#   deterministic -> offline, no API cost, reproducible. Default for tests/CI.
#   openai        -> text-embedding-3-small, requires OPENAI_API_KEY.
EK_EMBEDDER=deterministic
EK_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(N) column width in schema.sql.
EK_EMBEDDING_DIM=1536
OPENAI_API_KEY=

# --- retrieval (§6 -- canonical RRF configuration) ---------------------------
EK_DENSE_K=10
EK_SPARSE_K=10
EK_CANDIDATE_K=10
EK_FINAL_K=3
EK_RRF_K=60
# §9: applied as SET LOCAL inside the retrieval transaction.
EK_HNSW_EF_SEARCH=40

# --- reranking (§7) ----------------------------------------------------------
# flashrank | identity   (identity = pass-through, for offline/CI runs)
EK_RERANKER=identity
EK_RERANK_MODEL=ms-marco-TinyBERT-L-2-v2

# --- generation (Direct/LCEL adapter only -- never used by retrieval) --------
EK_CHAT_MODEL=gpt-4o-mini
EK_CHAT_TEMPERATURE=0

# --- logging -----------------------------------------------------------------
# §12: in MCP stdio mode stdout carries JSON-RPC only. Logs always go to stderr.
EK_LOG_LEVEL=INFO
